set -u
if [[ "${1:-}" == "--version" ]]; then
    echo "fio-3.36-mock"
    exit 0
fi
output_file=""
for argument in "$@"; do
    case "$argument" in
        --output=*) output_file="${argument#--output=}" ;;
    esac
done
if [[ -z "$output_file" ]]; then
    job_file=""
    for argument in "$@"; do
        [[ -f "$argument" ]] && job_file="$argument"
    done
    if [[ -n "$job_file" ]] && grep -q '^\[prepare_' "$job_file"; then
        dataset_size="$(awk -F '=' '$1 == "size" {print $2; exit}' "$job_file")"
        while IFS='=' read -r key dataset_path; do
            [[ "$key" == "filename" ]] || continue
            truncate -s "$dataset_size" "$dataset_path"
        done < "$job_file"
        echo "mock fio dataset preparation completed"
        exit 0
    fi
    echo "mock fio read-only dataset sample completed"
    exit 0
fi
{
    echo "mock fio normal output before JSON"
    sed 's/"fixture"/"runner-mock"/' "$(dirname -- "${BASH_SOURCE[0]}")/../fixture_jsonplus.json"
    echo "mock fio normal output after JSON"
} > "$output_file"
