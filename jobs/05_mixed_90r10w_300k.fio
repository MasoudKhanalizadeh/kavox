[global]
ioengine=libaio
direct=1
sync=0
thread=1
time_based=1
ramp_time=10
group_reporting=1
exitall_on_error=1
invalidate=1
refill_buffers=1
randrepeat=1
norandommap=1
percentile_list=50:95:99:99.9
filename=/mnt/storage/fio-test/fio-data-1TiB.bin
size=1099511627776
rw=randrw
rwmixread=90
bs=307200
iodepth=16
numjobs=16

[mixed_90r10w_300k]
